{
  "expo": {
    "name": "KEBU Live",
    "slug": "kebu-live",
    "scheme": "kebu-live",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {"bundleIdentifier": "com.kebu.live", "supportsTablet": true},
    "android": {"package": "com.kebu.live"},
    "plugins": [
      "@livekit/react-native-expo-plugin",
      ["@config-plugins/react-native-webrtc", {
        "cameraPermission": "KEBU Live uses your camera when you host a video broadcast.",
        "microphonePermission": "KEBU Live uses your microphone when you host a broadcast."
      }],
      "expo-secure-store"
    ]
  }
}
