# ── Supabase (required) ──────────────────────────────────────────────────────
# Get these from: supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # server-only, never expose to client
# Auth redirects (confirm email + forgot password): Supabase → Authentication → URL Configuration
# add: https://YOUR_APP/auth/callback  (and localhost for dev). Site URL = NEXT_PUBLIC_APP_URL.

# ── Admin / internal ─────────────────────────────────────────────────────────
ADMIN_PASSWORD=change_me_in_production
# Optional: dedicated HMAC secret for admin session cookies (recommended).
# If unset, ADMIN_PASSWORD is used only to sign the cookie — the password itself is never stored in the cookie.
# ADMIN_SESSION_SECRET=long_random_string_here
# Signed-in support staff who can open a user’s site builder (comma-separated emails).
# Requires SUPABASE_SERVICE_ROLE_KEY. Desk: /support
# KEBU_SUPPORT_ADMIN_EMAILS=support@kebu.africa,you@kebu.africa

# ── App URL (required for Stripe redirects + email links + live /sites URLs) ─
NEXT_PUBLIC_APP_URL=https://your-domain.com   # no trailing slash
# Note: kebu.africa is NOT owned yet. Do not point users at *.kebu.africa until
# the domain is registered and wildcard DNS/SSL points at this app.

# ── Stripe (payments) ────────────────────────────────────────────────────────
# dashboard.stripe.com → API keys (use test keys during dev)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# ── Twilio (SMS — weekly digests, event reminders, Yande texts) ──────────────
# console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxx
TWILIO_AUTH_TOKEN=xxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ── Cron secret ───────────────────────────────────────────────────────────────
# Any random string — used to authenticate Vercel cron → your API routes
CRON_SECRET=change_me_in_production

# ══════════════════════════════════════════════════════════════════════════════
#  YANDE AI ENGINE
#  All keys below are optional at launch — code skips gracefully if not set.
#  Add a key = feature activates automatically on next cron run.
# ══════════════════════════════════════════════════════════════════════════════

# ── Claude / Anthropic (Yande's brain) ───────────────────────────────────────
# Required for ALL AI features (Yande notes, Avenue editors, City Intelligence)
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Your private portfolio sites (May Lecor + K-Direction) ───────────────────
# Optional override. If empty, founder account goldendaffodilxo@gmail.com is allowed by default.
# Comma-separated login emails. Everyone else uses public templates only.
# Portfolio flagship sites (May Lecor · K-Direction · DkLNS · Ndaoan · RECT · Mayjor Good).
# Only these emails get auto-create on /create and /create/sites. Required on Vercel if you
# sign in with an address other than the default founder email.
# KEBU_PORTFOLIO_OWNER_EMAILS=you@kebu.africa,goldendaffodilxo@gmail.com
# KEBU_PORTFOLIO_OWNER_EMAILS=you@kebu.africa

# ── Site hosting billing (JOKO) ───────────────────────────────────────────────
# Monthly hosting ($3/mo). Every account pays except billing-exempt emails.
# JOKO_API_BASE_URL=https://api.joko.example
# JOKO_API_SECRET=
# JOKO_WEBHOOK_SECRET=
# Founder / ops free hosting (comma-separated). Portfolio owners are free by default too.
# KEBU_BILLING_EXEMPT_EMAILS=you@kebu.africa
# Daily cron: GET /api/cron/billing-monthly with Authorization: Bearer $CRON_SECRET
# Local/dev only: skip paid hosting gate so you can test publish without JOKO.
# Never enable in production.
# JOKO_BILLING_DEV_BYPASS=true

# ── Shop product pay adapters (Money: paid only after webhook/capture) ────────
# PayPal Orders API — set CLIENT_ID + SECRET; webhook verify needs WEBHOOK_ID in prod
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox
# PAYPAL_WEBHOOK_ID=
# PAYPAL_XOF_PER_USD=600
# Sandbox only — never in production:
# PAYPAL_WEBHOOK_SKIP_VERIFY=true
# Card via Paystack
# PAYSTACK_SECRET_KEY=
# PAYSTACK_CURRENCY=XOF
# When currency is NGN/GHS (not XOF), set XOF per 1 major unit — required, no silent 1:1:
# PAYSTACK_XOF_PER_UNIT=4
# PAYSTACK_XOF_PER_USD=600
# Wave mobile money
# WAVE_API_KEY=
# WAVE_API_BASE_URL=https://api.wave.com
# WAVE_WEBHOOK_SECRET=
# Orange Money (partner API — honest not-configured until set)
# ORANGE_MONEY_API_KEY=
# ORANGE_MONEY_MERCHANT_ID=
# ORANGE_MONEY_API_BASE_URL=

# ── Apify — TikTok scraper ────────────────────────────────────────────────────
# Powers: TikTok trend layer in City Intelligence + Girl Working work-sentiment
# Starter plan: $49/month (250 compute units — enough for 6+ months at current volume)
# Sign up: apify.com → create account → Settings → Integrations → API token
# Actor used: clockworks/tiktok-hashtag-scraper
# DORMANT until this key is added
APIFY_API_KEY=apify_api_...

# ── Yelp Fusion API ───────────────────────────────────────────────────────────
# Powers: top-rated NYC spots layer in City Intelligence
# FREE — 5,000 calls/day forever on the free plan
# Get key: yelp.com/developers → Create App → copy "API Key"
# DORMANT until this key is added
YELP_API_KEY=...

# ── Google Places API ─────────────────────────────────────────────────────────
# Powers: prominent NYC places layer in City Intelligence
# FREE up to $200/month (covers ~40,000 place searches — way more than needed)
# Get key: console.cloud.google.com → APIs & Services → Credentials → Create API key
#   Then enable: "Places API" in the APIs library
# DORMANT until this key is added
GOOGLE_PLACES_API_KEY=...

# ── Eventbrite API ────────────────────────────────────────────────────────────
# Powers: NYC events + pop-ups layer in City Intelligence
# FREE — 1,000 requests/day
# Get key: eventbrite.com/platform/api → Create App → copy API key
# DORMANT until this key is added
EVENTBRITE_API_KEY=...

# ── Custom domains / auto HTTPS (platform ops only — users never see this) ───
# Create a Vercel token for the Kebu project and set these on the Kebu deploy.
# Users only add CNAME at their registrar; Kebu attaches domains + SSL via API.
# From this repo after `vercel link`: projectId + orgId in .vercel/project.json
# vercel.com → Account Settings → Tokens
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Even on a personal/Hobby account, `vercel link` stores orgId as team_… — set it:
VERCEL_TEAM_ID=
# From this repo’s .vercel/project.json after link:
# VERCEL_PROJECT_ID=prj_P4Ou2No89MPIp1KdmnJHepJ818ED
# VERCEL_TEAM_ID=team_DuHLYw71m5ATHKdtGSur1Diw

