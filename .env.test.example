# .env.test.example
# ─────────────────────────────────────────────────────────────────────────────
# Environment variables needed to run the full blocked test suite.
# Copy to .env.test.local and fill in real values.
# NEVER commit a file with real credentials.
#
# All variables below are OPTIONAL at the unit-test level.
# Each test file has its own skip gate and will be skipped when its
# required vars are absent.
# ─────────────────────────────────────────────────────────────────────────────

# ── DB Concurrency Tests ─────────────────────────────────────────────────────
# Required for: tests/create/builder-sections-concurrency.db.test.ts
#
# Option A — local PostgreSQL (after running scripts/setup-test-db.sh):
# testuser password is set to 'kebu_test_pw' by the setup script (TCP/scram-sha-256).
DATABASE_URL=postgres://testuser:kebu_test_pw@127.0.0.1/kebu_test
#
# Option B — remote Supabase instance (NOT production):
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ── Authenticated Builder E2E ─────────────────────────────────────────────────
# Required for: tests/create/e2e-builder-full-journey.spec.ts
#               tests/create/e2e-builder-route.spec.ts
#               tests/create/e2e-builder-viewport.spec.ts
#
# KEBU_E2E_BASE_URL — URL of the running Next.js dev server or staging deployment.
#                     Do NOT use https://kebu.africa (production).
# KEBU_E2E_BUILDER_COOKIE — Value of the "session" cookie from a browser
#                            DevTools session logged into the test account.
#                            The cookie must belong to the SAME user who owns
#                            KEBU_E2E_PROJECT_ID.
# KEBU_E2E_PROJECT_ID — UUID of an existing project owned by the test account.
#                        Create one via the UI on the test server first.
KEBU_E2E_BASE_URL=http://localhost:3000
KEBU_E2E_BUILDER_COOKIE=
KEBU_E2E_PROJECT_ID=

# ── Supabase credentials (for E2E and SiteRenderer tests) ────────────────────
# Point at an ISOLATED test Supabase project, not production.
# Use the Supabase dashboard → Settings → API to get these values.
NEXT_PUBLIC_SUPABASE_URL=https://your-test-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App URL (used by E2E helpers to construct preview URLs) ──────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# HOW TO OBTAIN THE SESSION COOKIE (KEBU_E2E_BUILDER_COOKIE)
#
# 1. Start the dev server against a non-production Supabase project.
# 2. Open http://localhost:3000 in your browser.
# 3. Sign in with a test account (not the founder/production account).
# 4. Open DevTools → Application → Cookies → http://localhost:3000.
# 5. Copy the value of the "session" cookie.
# 6. Paste it into KEBU_E2E_BUILDER_COOKIE above.
# 7. Create a new project in the builder and copy its UUID from the URL
#    (/create/<uuid>) into KEBU_E2E_PROJECT_ID above.
#
# The cookie expires when the session expires or the browser clears cookies.
# Re-obtain it after expiry.
#
# WARNING: Never use credentials from https://kebu.africa.
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════════
#  QA HARNESS — Dedicated non-production Kebu QA Supabase project
#
#  Required for:
#    tests/create/qa-harness/*.ts
#    tests/create/builder-qa-authz.test.ts
#    tests/create/builder-qa-isolation.test.ts
#    tests/create/builder-qa-rpc.test.ts
#
#  RULES:
#   - Use a DEDICATED QA project — never production (https://kebu.africa or its DB)
#   - The harness checks SUPABASE_QA_DESIGNATED=true before running any test
#   - The harness checks SUPABASE_QA_URL does NOT match SUPABASE_PROD_URL
#   - Service-role key is server/test-process only — never logged, never in output
#   - Test users are created and deleted programmatically; no manual accounts needed
# ══════════════════════════════════════════════════════════════════════════════

# ── REQUIRED: QA project designation sentinel ─────────────────────────────────
# Must be exactly "true". The harness REFUSES to start without this.
# Only set on a project created exclusively for automated testing.
SUPABASE_QA_DESIGNATED=true

# ── REQUIRED: QA project API credentials ─────────────────────────────────────
# supabase.com/dashboard → your QA project → Settings → API

# Project URL (e.g. https://abcdefghijklmnop.supabase.co)
SUPABASE_QA_URL=https://YOUR_QA_PROJECT_ID.supabase.co

# anon/public key — used for unauthenticated and user-session simulation
SUPABASE_QA_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER

# service_role key — SERVER/TEST PROCESS ONLY; never in client bundles or logs
SUPABASE_QA_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER

# ── REQUIRED: Direct Postgres connection for migration verification ────────────
# supabase.com/dashboard → QA project → Settings → Database → Connection string (URI)
# Fill in your DB password. Use the direct (non-pooler) connection string.
SUPABASE_QA_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_QA_PROJECT_ID.supabase.co:5432/postgres

# ── RECOMMENDED: Production project URL denylist sentinel ─────────────────────
# The harness refuses to run if SUPABASE_QA_URL matches this value.
# Get from production project → Settings → API → Project URL.
SUPABASE_PROD_URL=https://YOUR_PRODUCTION_PROJECT_ID.supabase.co

# ── OPTIONAL: QA project ref for extra identity verification ──────────────────
# 20-character project reference visible in the dashboard URL.
# If set, the harness verifies the connected project ref matches before running.
SUPABASE_QA_PROJECT_REF=YOUR_20_CHAR_QA_PROJECT_REF

# ─────────────────────────────────────────────────────────────────────────────
# SETUP STEPS FOR THE QA PROJECT
#
# 1. Create a new Supabase project (free tier is fine — never the production project)
# 2. Copy credentials above from: dashboard → your QA project → Settings → API
# 3. Apply all migrations: the harness verifier will check they are present,
#    but you can apply them manually first via:
#      psql $SUPABASE_QA_DB_URL -f supabase/migrations/APPLY_ALL_PHASE_ONE.sql
#    then apply each dated migration in order.
# 4. The harness creates and cleans up all test users automatically.
#    No manual user creation is required.
# ─────────────────────────────────────────────────────────────────────────────
